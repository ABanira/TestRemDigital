<Page x:Class="TestRemDigital.Views.CalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestRemDigital.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1024"
      Title="CalibrationPage" Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- HEADER -->
            <RowDefinition Height="Auto"/>
            <!-- STATUS KONEKSI -->
            <RowDefinition Height="*"/>
            <!-- INDIKATOR SENSOR (FLEXIBLE) -->
            <RowDefinition Height="Auto"/>
            <!-- FOOTER -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER PAGE -->
        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,0,0,10">
            <TextBlock Text="🛠️ DIAGNOSTICS &amp; KALIBRASI SENSOR" FontSize="20" FontWeight="Bold" Foreground="#F97316"/>
            <TextBlock Text="Halaman pengujian fisik komponen hardware, konektivitas, dan pembacaan sensor tekanan." FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            <Border BorderBrush="#374151" BorderThickness="0,0,0,1.5" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- 2. BAR STATUS KONEKSI -->
        <Border Grid.Row="1" Background="#1F2937" CornerRadius="8" Padding="12,8" Margin="0,5,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="STATUS KONEKSI MODBUS:" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Name="BdrStatusKoneksi" Background="#EF4444" CornerRadius="5" Padding="8,4">
                        <TextBlock Name="TxtStatusKoneksi" Text="DISCONNECTED" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="KONFIGURASI AKTIF:" Foreground="#9CA3AF" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtInfoKonfigurasi" Text="COM - | 9600 bps | ID: 1" Foreground="#10B981" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. INDIKATOR 4 SENSOR TEKANAN -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PIPA UTAMA (BP) -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="PIPA UTAMA (BP)" Foreground="#3B82F6" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Name="BarBP" Minimum="0" Maximum="10" Value="0" Orientation="Vertical" Width="32" Margin="0,10" Foreground="#3B82F6" Background="#334155" BorderThickness="0"/>
                    <TextBlock Grid.Row="2" Name="TxtBP" Text="0.00 Bar" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- TANGKI UTAMA (AR) -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TANGKI UTAMA (AR)" Foreground="#10B981" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Name="BarAR" Minimum="0" Maximum="10" Value="0" Orientation="Vertical" Width="32" Margin="0,10" Foreground="#10B981" Background="#334155" BorderThickness="0"/>
                    <TextBlock Grid.Row="2" Name="TxtAR" Text="0.00 Bar" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- TANGKI KONTROL (CR) -->
            <Border Grid.Column="4" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TANGKI KONTROL (CR)" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Name="BarCR" Minimum="0" Maximum="10" Value="0" Orientation="Vertical" Width="32" Margin="0,10" Foreground="#F59E0B" Background="#334155" BorderThickness="0"/>
                    <TextBlock Grid.Row="2" Name="TxtCR" Text="0.00 Bar" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SILINDER REM (BC) -->
            <Border Grid.Column="6" Background="#1E293B" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SILINDER REM (BC)" Foreground="#EF4444" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <ProgressBar Grid.Row="1" Name="BarBC" Minimum="0" Maximum="10" Value="0" Orientation="Vertical" Width="32" Margin="0,10" Foreground="#EF4444" Background="#334155" BorderThickness="0"/>
                    <TextBlock Grid.Row="2" Name="TxtBC" Text="0.00 Bar" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. FOOTER BUTTON -->
        <Grid Grid.Row="3" VerticalAlignment="Bottom">
            <Border HorizontalAlignment="Left" Background="#374151" BorderBrush="#4B5563" BorderThickness="1.5" CornerRadius="8" Width="160" Height="38">
                <Grid>
                    <Button Name="BtnKembali" Click="BtnKembali_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="⬅️ KEMBALI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>