<Page x:Class="TestRemDigital.Views.LoadDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestRemDigital.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1024"
      Title="LoadDataPage" Background="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- HEADER & CARI -->
            <RowDefinition Height="*"/>
            <!-- DATAGRID RIWAYAT (FLEXIBLE) -->
            <RowDefinition Height="Auto"/>
            <!-- FOOTER & PAGINATION -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER & SEARCH BAR -->
        <Border Grid.Row="0" BorderBrush="#374151" BorderThickness="0,0,0,1.5" Margin="0,0,0,12" Padding="0,0,0,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="ARSIP DATA PENGUJIAN (HISTORY LOG)" FontSize="20" FontWeight="Bold" Foreground="#F97316"/>
                    <TextBlock Text="Cari dan tinjau ulang hasil pengujian sarana" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Cari No KA:" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="TxtCariNoKA" Width="200" Height="34" FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center" Padding="8,0" Background="#1E2937" Foreground="White" BorderBrush="#4B5563" TextChanged="TxtCariNoKA_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. DATAGRID HISTORI -->
        <DataGrid Grid.Row="1" Name="DgRiwayatUji" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#1E2937" RowBackground="#111827" AlternatingRowBackground="#1E2937" 
                  Foreground="White" BorderBrush="#374151" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#374151"
                  RowHeight="38" FontSize="13" FontWeight="Medium" SelectionMode="Single" HeadersVisibility="Column" Margin="0,0,0,12">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="TANGGAL UJI" Binding="{Binding TanggalFormat}" Width="2*"/>
                <DataGridTextColumn Header="NOMOR KA / SARANA" Binding="{Binding NomorKA}" Width="2.5*"/>
                <DataGridTextColumn Header="PROG. PERAWATAN" Binding="{Binding ProgramPerawatan}" Width="2*"/>
                <DataGridTextColumn Header="KESIMPULAN" Binding="{Binding StatusKelulusan}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 3. FOOTER & PAGINATION -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- TOMBOL KEMBALI -->
            <Border Grid.Column="0" Background="#374151" BorderBrush="#4B5563" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnKembali" Click="BtnKembali_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="⬅️ KEMBALI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- KONTROL PAGINATION -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Name="BtnPrev" Content="◀ Prev" Width="75" Height="34" Click="BtnPrev_Click" 
                        Background="#374151" Foreground="White" FontWeight="Bold" BorderBrush="#4B5563" Margin="4,0" Cursor="Hand"/>

                <TextBlock Name="TxtInfoHalaman" Text="Halaman 1 dari 1" Foreground="White" 
                           VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="8,0"/>

                <Button Name="BtnNext" Content="Next ▶" Width="75" Height="34" Click="BtnNext_Click" 
                        Background="#374151" Foreground="White" FontWeight="Bold" BorderBrush="#4B5563" Margin="4,0" Cursor="Hand"/>
            </StackPanel>

            <!-- TOMBOL RE-VIEW DETAIL -->
            <Border Grid.Column="2" Background="#2563EB" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnBukaDetail" Click="BtnBukaDetail_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="🔎 RE-VIEW DETAIL DATA" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>