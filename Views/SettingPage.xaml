<Page x:Class="TestRemDigital.Views.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestRemDigital.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1024"
      Title="SettingPage" Background="#111827">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- HEADER -->
            <RowDefinition Height="*"/>
            <!-- CONTENT / BODY (SCROLLABLE) -->
            <RowDefinition Height="Auto"/>
            <!-- FOOTER BUTTONS -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,0,0,10">
            <TextBlock Text="⚙️ PENGATURAN SYSTEM &amp; HARDWARE" FontSize="20" FontWeight="Bold" Foreground="#F97316"/>
            <TextBlock Text="Konfigurasi Modbus RS485, Pengesahan Laporan, &amp; Cloud Integration" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            <Border BorderBrush="#374151" BorderThickness="0,0,0,1.5" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- 2. CONTENT / BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12" Padding="0,0,5,0">
            <StackPanel>

                <!-- KELOMPOK 1: HARDWARE RS485 MODBUS -->
                <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🔌 KONFIGURASI RS485 / MODBUS SENSOR" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KOLOM KIRI -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Port Serial (COM Port)" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox Name="CmbPortName" Height="34" Background="#374151" Foreground="Black" FontSize="13" Padding="6,4"/>

                                <TextBlock Text="Baud Rate" Foreground="White" FontSize="12" Margin="0,8,0,4"/>
                                <ComboBox Name="CmbBaudRate" Height="34" Background="#374151" Foreground="Black" FontSize="13" Padding="6,4">
                                    <ComboBoxItem Content="9600" IsSelected="True"/>
                                    <ComboBoxItem Content="19200"/>
                                    <ComboBoxItem Content="38400"/>
                                    <ComboBoxItem Content="115200"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- KOLOM KANAN -->
                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Slave ID" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Name="TxtSlaveId" Text="1" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Base Register" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Name="TxtRegisterAddress" Text="0" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Kapasitas Sensor / Faktor Koreksi (Bar)" Foreground="White" FontSize="12" Margin="0,8,0,4"/>
                                <TextBox Name="TxtMaxSensorBar" Text="10.0" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- KELOMPOK 2: IDENTITAS PENGESAHAN -->
                <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="✍️ IDENTITAS PENGESAHAN LAPORAN (TTD)" Foreground="#4ADE80" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KOLOM OPERATOR -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nama Operator Pengujian" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Name="TxtNamaOperator" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>

                                <TextBlock Text="NIPP Operator" Foreground="White" FontSize="12" Margin="0,8,0,4"/>
                                <TextBox Name="TxtNipOperator" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <!-- KOLOM PENGAWAS -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nama Pengawas / Pemeriksa" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Name="TxtNamaPengawas" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>

                                <TextBlock Text="NIPP Pengawas" Foreground="White" FontSize="12" Margin="0,8,0,4"/>
                                <TextBox Name="TxtNipPengawas" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- KELOMPOK 3: GOOGLE SHEETS INTEGRATION -->
                <Border Background="#1F2937" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📊 GOOGLE SHEETS" Foreground="#FACC15" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Google Apps Script URL" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Name="TxtGoogleWebhookUrl" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="12" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nama Tab / Sheet" Foreground="White" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Name="TxtGoogleSheetName" Text="Hasil_Uji" Height="34" Background="#374151" Foreground="White" BorderBrush="#4B5563" FontSize="13" VerticalContentAlignment="Center" Padding="6,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. FOOTER BUTTONS -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#374151" BorderBrush="#4B5563" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnKembali" Click="BtnKembali_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="⬅️ KEMBALI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0284C7" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnSimpanSetting" Click="BtnSimpanSetting_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="💾 SIMPAN KONFIGURASI" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>