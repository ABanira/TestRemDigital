<Page x:Class="TestRemDigital.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestRemDigital.Views"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1024"
      Title="ReportPage" Background="#0F172A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- HEADER -->
            <RowDefinition Height="*"/>
            <!-- CONTENT AREA (SCROLLABLE) -->
            <RowDefinition Height="Auto"/>
            <!-- FOOTER NAVIGASI -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER LAPORAN & STATUS AKHIR -->
        <Border Grid.Row="0" BorderBrush="#374151" BorderThickness="0,0,0,1.5" Margin="0,0,0,12" Padding="0,0,0,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="LAPORAN HASIL EVALUASI AKHIR (REPORT)" FontSize="20" FontWeight="Bold" Foreground="#F97316"/>
                    <TextBlock Name="TxtReportTanggal" Text="TANGGAL: --/--/----" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" Name="BdrKesimpulanAkhir" Background="#10B981" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Name="TxtKesimpulanAkhir" Text="LULUS UJI" FontSize="14" FontWeight="Black" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. KONTEN LAPORAN (SCROLLABLE AREA) -->
        <Border Grid.Row="1" Background="#1E2937" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
                <StackPanel>

                    <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#374151" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NOMOR KA / SARANA:" Foreground="#F97316" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Name="TxtLblNoKA" Text="-" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PROGRAM PERAWATAN:" Foreground="#F97316" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Name="TxtLblProgramPerawatan" Text="-" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SECTION 1: EVALUASI PARAMETER PENGUJIAN (DISESUAIKAN DENGAN STANDAR) -->
                    <TextBlock Text="1. TEST PENGISIAN (CHARGING)" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Border Background="#334155" Padding="8,5" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PARAMETER PENGUJIAN" FontWeight="Bold" Foreground="White" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="STANDAR TOLERANSI" FontWeight="Bold" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="HASIL AKTUAL" FontWeight="Bold" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="STATUS EVALUASI" FontWeight="Bold" Foreground="White" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waktu pengisian Auxiliary Reservoir (AR)" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="38 - 135 detik" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtHasilChargingAR" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusChargingAR" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waktu pengisian Control Chamber (CR)" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="160 - 200 detik" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtHasilChargingCR" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusChargingCR" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Separator Background="#374151" Margin="0"/>

                    <TextBlock Text="2. TEST KEBOCORAN" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,6,0,6"/>
                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Penurunan Tekanan (drop) pada BP dalam 1 menit" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Maksimal 0.30 Bar" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtHasilBocor" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusBocor" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Separator Background="#374151" Margin="0"/>

                    <TextBlock Text="3. TEST PELAYANAN PENGEREMAN (SERVICE BRAKE)" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,6,0,6"/>
                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pengurangan tekanan di Brake Pipe sebesar 0,5 bar" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="0.7 - 1.0 Bar (BC)" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtBcAt05" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusBcAt05" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pengurangan tekanan di Brake Pipe sebesar 1,0 bar" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="1.8 - 2.5 Bar (BC)" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtBcAt10" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusBcAt10" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pengurangan tekanan di Brake Pipe sebesar 1,5 bar (full service)" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="3.7 - 3.8 Bar (BC)" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtBcAt15" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusBcAt15" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Separator Background="#374151" Margin="0"/>

                    <TextBlock Text="4. TEST PENGEREMAN DARURAT (EMERGENCY BRAKE)" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,6,0,6"/>
                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Brake Response (waktu sampai 95% pada brake cylinder)" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="3 - 5 detik" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtEmergencyResponse" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusEmergencyResponse" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tekanan maksimum pada Brake Cylinder" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="3.8 ± 0.1 Bar" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtEmergencyBcMax" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusEmergencyBcMax" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Separator Background="#374151" Margin="0"/>

                    <TextBlock Text="5. TEST PELEPASAN (RELEASE)" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,6,0,6"/>
                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waktu pelepasan sampai BC ≤ 0.4 bar" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="15 - 20 detik" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtHasilRelease" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusRelease" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,6" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tekanan Air Reservoir pada saat BC = 0.4 bar" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="4.7 - 4.85 Bar" Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtReleaseArPressure" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtStatusReleaseArPressure" Text="-" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- SECTION 2: TABEL DYNAMIC RINGKASAN MULTI-SIKLUS (1x - 5x) -->
                    <TextBlock Text="2. RINCIAN EVALUASI MULTI-SIKLUS PENGUJIANS" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,10,0,6"/>
                    <DataGrid Name="DgMultiSiklus" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                              Background="#111827" RowBackground="#1E2937" AlternatingRowBackground="#111827" 
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#374151" 
                              BorderThickness="1" BorderBrush="#374151" FontSize="11" RowHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SIKLUS" Binding="{Binding NomorSiklusText}" Width="1*"/>
                            <DataGridTextColumn Header="CHG AR (s)" Binding="{Binding ChargingARDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="CHG CR (s)" Binding="{Binding ChargingDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="LEAK (Bar)" Binding="{Binding BocorDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="BRAKE (s)" Binding="{Binding RemDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="RELEASE (s)" Binding="{Binding ReleaseDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="STATUS SIKLUS" Binding="{Binding StatusDisplay}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- SECTION 3: TABEL RINGKASAN TEKANAN PER FASE -->
                    <TextBlock Text="3. RINGKASAN TEKANAN UDARA PER FASE SIKLUS TERAKHIR (BAR)" Foreground="#F97316" FontSize="12" FontWeight="Bold" Margin="0,10,0,6"/>
                    <Border Background="#334155" Padding="8,5" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FASE PENGUJIAN" FontWeight="Bold" Foreground="White" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="BP (Bar)" FontWeight="Bold" Foreground="#60A5FA" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="AR (Bar)" FontWeight="Bold" Foreground="#34D399" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="CR (Bar)" FontWeight="Bold" Foreground="#C084FC" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="BC (Bar)" FontWeight="Bold" Foreground="#F87171" FontSize="10" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,5" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Akhir Charging" Foreground="White" FontSize="11"/>
                            <TextBlock Grid.Column="1" Name="TxtBpCharging" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtArCharging" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtCrCharging" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Name="TxtBcCharging" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Akhir Uji Kebocoran (Leak)" Foreground="White" FontSize="11"/>
                            <TextBlock Grid.Column="1" Name="TxtBpLeak" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtArLeak" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtCrLeak" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Name="TxtBcLeak" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,5" Background="#111827">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Akhir Pengereman" Foreground="White" FontSize="11"/>
                            <TextBlock Grid.Column="1" Name="TxtBpBrake" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtArBrake" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtCrBrake" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Name="TxtBcBrake" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Akhir Releasing" Foreground="White" FontSize="11"/>
                            <TextBlock Grid.Column="1" Name="TxtBpRelease" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TxtArRelease" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Name="TxtCrRelease" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Name="TxtBcRelease" Text="0.00" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- SECTION 4: GRAFIK TREN -->
                    <DockPanel Margin="0,10,0,5">
                        <TextBlock Text="4. GRAFIK TREN TEKANAN SIKLUS UJI" Foreground="#F97316" FontSize="12" FontWeight="Bold" DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#3B82F6" Width="8" Height="8" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BP" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Border Background="#10B981" Width="8" Height="8" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AR" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Border Background="#A855F7" Width="8" Height="8" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CR" Foreground="White" FontSize="10" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <Border Background="#EF4444" Width="8" Height="8" CornerRadius="2" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BC" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Background="#111827" CornerRadius="6" Padding="6" Margin="0,4,0,5" BorderBrush="#374151" BorderThickness="1">
                        <Grid MinHeight="160">
                            <Image Name="ImgGrafikReport" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="200"/>
                            <TextBlock Name="TxtAlertMessage" Foreground="#EF4444" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3. FOOTER NAVIGASI -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- TOMBOL KEMBALI KE MENU -->
            <Border Grid.Column="0" Background="#374151" BorderBrush="#4B5563" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnMenuUtama" Click="BtnMenuUtama_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="🏠 KEMBALI KE MENU" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- TOMBOL SIMPAN & CETAK PDF -->
            <Border Grid.Column="2" Name="BdrBtnSimpan" Background="#059669" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Height="38">
                <Grid>
                    <Button Name="BtnSimpanCetak" Click="BtnSimpanCetak_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="💾 SIMPAN &amp; CETAK PDF" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>